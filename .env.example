# ==========================================
# SHREE HARI - SUPABASE CONFIGURATION
# ==========================================

# 1. Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon Public Key (from Supabase Dashboard -> Project Settings -> API)
# Example: eyJhbGciOi...
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Optional Backend Server Keys
PORT=3000
